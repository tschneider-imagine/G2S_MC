    "psu_2_gpio_pin": 23,
    "buzzer_gpio_pin": 18,
    "active_low_inputs": true
  },
  "power_management": {
    "critical_battery_threshold_percent": 5,
    "buzzer_on_single_psu_failure": true
  },
  "crypto": {
    "g2s_client_cert_path": "/etc/g2s-mute/certs/client.crt",
    "g2s_client_key_path": "/etc/g2s-mute/certs/client.key",
    "g2s_ca_cert_path": "/etc/g2s-mute/certs/ca.crt",
    "web_server_cert_path": "",
    "web_server_key_path": ""
  },
  "api": {
    "auth_token": ""
  },
  "alerts": {
    "grey_threshold_count_to_buzz": 3,
    "grey_threshold_percent_to_buzz": 15.0
  },
  "timeouts": {
    "g2s_request_timeout_ms": 5000,
    "egm_heartbeat_interval_ms": 5000,
    "ui_session_timeout_minutes": 30
  },
  "database": {
    "path": "/var/lib/g2s-mute/controller.db"
  },
  "web_ui": {
    "bind_address": "0.0.0.0:8444",
    "require_login": false,
    "require_client_cert_for_admin": false,
    "allow_private_key_export": false,
    "allow_trusted_private_network_mutations": true
