    "host_url": "http://127.0.0.1:8444/g2s",
    "endpoint_path": "/g2s",
    "require_tls": false,
    "require_client_cert": false
  },
  "runtime": {
    "input_runtime_enabled": true,
    "input_runtime_seed_defaults": true,
    "input_runtime_execute_actions": true,
    "input_runtime_interval_ms": 100,
    "delivery_topology": "HOST_LISTENER"
  },
  "egm_roster": [
    {
      "egm_id": "EGM-001",
      "ip_address": "192.168.50.101",
      "port": 9443,
      "vendor": "Generic",
      "cabinet_family": "Generic",
      "game_title": "Cabinet 001",
      "software_version": "1.0.0"
    }
  ]
