    "listener_ip": "192.168.50.40",
    "required_san_dns": [
      "pi-cabinet-host.example"
    ],
    "required_san_ips": [
      "192.168.50.40"
    ],
    "host_id": "HOST-PI-001",
    "first_test_egm_ids": [
      "EGM-001"
    ]
  },
  "hardware_io": {
    "security_line_gpio_pin": 17,
    "voltage_drop_threshold_ms": 250,
